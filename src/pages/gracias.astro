---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="¡Mensaje Enviado con Éxito! | Sinai Mantenimiento Integral"
  description="Gracias por contactar a Sinai Mantenimiento Integral. Andrés y Verónica se comunicarán contigo a la brevedad."
>
  <Header />

  <main class="py-20 lg:py-28 bg-slate-50 flex items-center justify-center min-h-[70vh]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Check icon -->
      <div class="w-20 h-20 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-8 shadow-inner animate-bounce">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200">
        Solicitud Registrada Correctamente
      </span>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        ¡Muchas Gracias por Contactarnos!
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-lg mx-auto">
        Hemos recibido tu solicitud de presupuesto. <strong class="text-slate-800">Andrés o Verónica</strong> revisarán los detalles y se pondrán en contacto contigo a la brevedad.
      </p>

      <!-- Urgent Box -->
      <div class="mt-8 p-6 rounded-3xl bg-white border-2 border-emerald-500/40 shadow-xl max-w-md mx-auto space-y-4">
        <div class="flex items-center justify-center gap-2 text-red-600 font-bold text-sm">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
          <span>¿Es una urgencia o prefieres respuesta inmediata?</span>
        </div>
        
        <p class="text-xs text-slate-500">
          Haz clic aquí para abrir un chat directo y enviarnos fotos o detalles por WhatsApp:
        </p>

        <a
          href="https://wa.me/59896219719?text=Hola%20Andr%C3%A9s%20y%20Ver%C3%B3nica,%20acabo%20de%20enviar%20el%20formulario%20web%20y%20quisiera%20agilizar%20el%20presupuesto"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-3.5 px-6 rounded-xl shadow-md transition-all text-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Abrir WhatsApp Ahora</span>
        </a>

        <div class="text-xs text-slate-500">
          O llámanos directamente al <a href="tel:+59896219719" class="font-bold text-slate-800 underline">096 219 719</a>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-700"
        >
          ← Volver a la página principal
        </a>
      </div>

    </div>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
