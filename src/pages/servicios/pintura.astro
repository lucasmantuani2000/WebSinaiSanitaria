---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ContactForm from '../../components/ContactForm.astro';
import WorkGallery from '../../components/WorkGallery.astro';

const pinturaServices = [
  {
    title: "Pintura Látex Lavable Anti-Hongos para Interiores",
    desc: "Aplicación a dos manos con pinturas de alto poder cubritivo y aditivos fungicidas para evitar manchas en cielorrasos y paredes de dormitorios, cocinas y baños.",
    urgente: false
  },
  {
    title: "Pintura de Fachadas y Revestimientos Elastoméricos",
    desc: "Tratamiento exterior con hidrolavado previo, sellador fijador y aplicación de pinturas impermeabilizantes elásticas o revestimientos plásticos texturados resistentes al sol y la salinidad marina.",
    urgente: false
  },
  {
    title: "Esmaltes Sintéticos para Herrería y Maderas",
    desc: "Protección anticorrosiva y esmalte satinado o brillante para rejas, portones, postigones, aberturas y barandas con lijado a fondo y desengrasado.",
    urgente: false
  },
  {
    title: "Tratamiento de Humedades, Hongos y Descascarados",
    desc: "Raspado mecánico de capas ampolladas, lavado con fungicida clorado, aplicación de bloqueador de humedad y sellador fijador al aguarrás para bases firmes.",
    urgente: false
  },
  {
    title: "Enduido Completo y Lijado Libre de Polvo",
    desc: "Nivelación fina de paredes con enduido interior o exterior, eliminación de imperfecciones y lijado prolijo para lograr paredes lisas como seda.",
    urgente: false
  },
  {
    title: "Pintura Epoxi para Pisos y Trabajos en Altura",
    desc: "Recubrimientos de alta resistencia mecánica y química para garajes, locales comerciales y depósitos, así como pintura de muros de altura con arneses certificados.",
    urgente: false
  }
];

const galleryItems = [
  {
    title: "Pintura interior con látex lavable anti-hongos en apartamento",
    description: "Tratamiento con lavandina concentrada, fijador al agua, enduido completo y aplicación de 3 manos de látex lavable mate de primera línea.",
    location: "Pocitos, Montevideo",
    image: "/images/servicios/pintura.svg",
    alt: "Pintura interior lavable en Pocitos Montevideo",
    tag: "Látex Lavable"
  },
  {
    title: "Restauración de fachada con pintura elastomérica impermeable",
    description: "Sellado de microfisuras, hidrolavado a 180 bar y aplicación de recubrimiento elástico impermeable blanco atérmico en casona antigua.",
    location: "Prado, Montevideo",
    image: "/images/servicios/pintura.svg",
    alt: "Pintura de fachada con elastomérico en Prado Montevideo",
    tag: "Pintura de Fachadas"
  },
  {
    title: "Esmalte sintético y protección anticorrosiva para herrería",
    description: "Remoción de óxido, aplicación de dos manos de fondo cromato de zinc y esmalte sintético satinado negro grafito para rejas y portón.",
    location: "Carrasco, Montevideo",
    image: "/images/servicios/pintura.svg",
    alt: "Esmalte sintético en rejas y portones en Carrasco Montevideo",
    tag: "Protección Herrería"
  }
];

const whatsappUrl = "https://wa.me/59896219719?text=Hola%2C%20quisiera%20solicitar%20presupuesto%20para%20Pintura%20profesional.";
---

<Layout
  title="Pintura Profesional de Interiores y Exteriores | SINAI"
  description="Pintura profesional de interiores y exteriores en Montevideo y Canelones: Látex anti-hongos, fachadas con elastoméricos, esmaltes y enduidos. Factura oficial con RUT. Andrés y Verónica."
>
  <Header />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-950 via-slate-900 to-amber-950 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>Pintura Profesional • Preparación Impecable • Factura con RUT</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
          Pintura Profesional de Interiores y Exteriores en Uruguay
        </h1>

        <p class="mt-6 text-base sm:text-xl text-slate-300 leading-relaxed">
          El 80% de una buena pintura radica en la preparación de la superficie. En Sinai reparamos grietas, eliminamos hongos y enduidamos a fondo para una terminación premium garantizada por <strong class="text-white">Andrés y Verónica</strong>.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold px-7 py-4 rounded-2xl shadow-xl shadow-emerald-600/30 text-base transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Pedir Presupuesto por WhatsApp</span>
          </a>

          <a
            href="tel:+59896219719"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-bold px-7 py-4 rounded-2xl border border-slate-700 text-base transition-all"
          >
            <span>Llamar: 096 219 719</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed services -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Trabajos de Pintura de Obra y Mantenimiento
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Cuidado riguroso del mobiliario y pisos con cintas de enmascarar y plásticos cobertores durante toda la labor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pinturaServices.map((srv) => (
          <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                </span>
                <span class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
                  Terminación Impecable
                </span>
              </div>

              <h3 class="text-xl font-black text-slate-900 mb-2">{srv.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{srv.desc}</p>
            </div>

            <div class="mt-6 pt-5 border-t border-slate-100">
              <a
                href={`https://wa.me/59896219719?text=${encodeURIComponent(`Hola Andrés y Verónica, consulto por presupuesto para ${srv.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-amber-600 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition-colors"
              >
                Cotizar este trabajo por WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Work Gallery -->
  <WorkGallery
    title="Galería de Acabados en Pintura Profesional"
    subtitle="Resultados de pintura interior lavable y restauración de fachadas ejecutados en Montevideo."
    serviceCategory="Pintura Profesional"
    items={galleryItems}
  />

  <!-- Form integration -->
  <ContactForm />

  <Footer />
  <WhatsAppButton />
</Layout>
