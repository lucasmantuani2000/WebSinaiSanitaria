---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ContactForm from '../../components/ContactForm.astro';
import WorkGallery from '../../components/WorkGallery.astro';

const limpiezaServices = [
  {
    title: "Limpieza Profunda Fin de Obra",
    desc: "Limpieza integral para entrega inmediata de viviendas, apartamentos a estrenar y oficinas tras refacciones o construcciones nuevas.",
    urgente: false
  },
  {
    title: "Remoción de Restos de Cemento y Pintura",
    desc: "Limpieza técnica de pisos, cerámicas y zócalos con químicos desincrustantes que no dañan el esmalte, eliminando restos de pastina, pegamento y salpicaduras.",
    urgente: false
  },
  {
    title: "Corte de Césped y Mantenimiento de Jardines",
    desc: "Corte de pasto con motoguadaña y cortadora rotativa, orillado prolijo de senderos y mantenimiento periódico de canteros y plantas ornamentales.",
    urgente: false
  },
  {
    title: "Desmalezado y Limpieza de Terrenos",
    desc: "Acondicionamiento de predios baldíos, retiro de maleza densa, chircas y nivelación superficial para prevención de incendios y control de plagas.",
    urgente: false
  },
  {
    title: "Podas de Mantenimiento y Formación",
    desc: "Corte de ramas secas o peligrosas en árboles y cercos vivos, podas de despeje de cables eléctricos o techos con motosierras y elementos de seguridad.",
    urgente: false
  },
  {
    title: "Retiro y Disposición de Restos Vegetales",
    desc: "Carga y traslado responsable en camión de ramas, podas y escombros hacia los centros de disposición autorizados de las intendencias correspondientes.",
    urgente: false
  }
];

const galleryItems = [
  {
    title: "Limpieza profunda fin de obra en edificio de apartamentos",
    description: "Desincrustado químico no agresivo de 12 unidades nuevas, retiro de siliconas en cristales y aspirado de polvillo fino de yeso.",
    location: "Pocitos, Montevideo",
    image: "/images/servicios/limpieza-jardineria.svg",
    alt: "Limpieza final de obra en edificio en Pocitos Montevideo",
    tag: "Entrega Inmediata"
  },
  {
    title: "Mantenimiento de parque y corte de césped en predio",
    description: "Corte con tractor desmalezador y motoguadaña en terreno de 1.800m², perfilado de cercos perimetrales y desmalezado de canteros.",
    location: "Solymar, Canelones",
    image: "/images/servicios/limpieza-jardineria.svg",
    alt: "Corte de césped y mantenimiento de jardín en Solymar Canelones",
    tag: "Parquización"
  },
  {
    title: "Poda de altura y despeje sobre techo y líneas eléctricas",
    description: "Poda correctiva de eucaliptos y pinos con retiro en camión de 12m³ de restos de ramas hacia cantera autorizada de Intendencia.",
    location: "Carrasco Norte, Montevideo",
    image: "/images/servicios/limpieza-jardineria.svg",
    alt: "Poda de árboles y retiro de restos vegetales en Carrasco Norte",
    tag: "Poda en Altura"
  }
];

const whatsappUrl = "https://wa.me/59896219719?text=Hola%2C%20quisiera%20solicitar%20presupuesto%20para%20Limpieza%20o%20Jardiner%C3%ADa.";
---

<Layout
  title="Limpieza Final de Obra y Mantenimiento de Jardines | SINAI"
  description="Limpieza fin de obra y jardinería en Montevideo y Canelones: Remoción de cemento y pintura, corte de césped, podas y desmalezado. Facturación oficial con RUT. Andrés y Verónica."
>
  <Header />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-950 via-slate-900 to-teal-950 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-600/30 border border-teal-500/40 text-teal-300 text-xs font-bold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-teal-400"></span>
          <span>Limpieza de Obra y Jardines • Entrega Impecable • Factura con RUT</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
          Limpieza Final de Obra y Jardines en Uruguay
        </h1>

        <p class="mt-6 text-base sm:text-xl text-slate-300 leading-relaxed">
          Entrega tu propiedad 100% habitable y reluciente. Eliminamos polvo fino, restos de cemento y dejamos los exteriores y jardines en condiciones óptimas con la supervisión de <strong class="text-white">Andrés y Verónica</strong>.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold px-7 py-4 rounded-2xl shadow-xl shadow-emerald-600/30 text-base transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Pedir Presupuesto por WhatsApp</span>
          </a>

          <a
            href="tel:+59896219719"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-bold px-7 py-4 rounded-2xl border border-slate-700 text-base transition-all"
          >
            <span>Llamar: 096 219 719</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed services -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Servicios de Limpieza de Obra y Espacios Verdes
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Equipamiento profesional: hidrolavadoras de alta presión, aspiradoras industriales y maquinaria de corte de césped y poda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {limpiezaServices.map((srv) => (
          <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-teal-100 text-teal-800 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                </span>
                <span class="text-xs font-bold text-teal-800 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-full">
                  Entrega 100% Lista
                </span>
              </div>

              <h3 class="text-xl font-black text-slate-900 mb-2">{srv.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{srv.desc}</p>
            </div>

            <div class="mt-6 pt-5 border-t border-slate-100">
              <a
                href={`https://wa.me/59896219719?text=${encodeURIComponent(`Hola Andrés y Verónica, consulto por presupuesto para ${srv.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-teal-600 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition-colors"
              >
                Cotizar este trabajo por WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Work Gallery -->
  <WorkGallery
    title="Galería de Limpiezas Finales y Parquización"
    subtitle="Inmuebles acondicionados y entregados impecables en Montevideo y Ciudad de la Costa."
    serviceCategory="Limpieza y Jardinería"
    items={galleryItems}
  />

  <!-- Form integration -->
  <ContactForm />

  <Footer />
  <WhatsAppButton />
</Layout>
