---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ContactForm from '../../components/ContactForm.astro';
import WorkGallery from '../../components/WorkGallery.astro';

const sanitaryServices = [
  {
    title: "Destapes de Cañerías y Cloacas",
    desc: "Destape mecánico con resortes de acero y sondas de alta potencia para cañerías obstruidas, cámaras sépticas, pluviales y graseras de cocina.",
    urgente: true
  },
  {
    title: "Detección y Reparación de Pérdidas",
    desc: "Localización precisa de fugas ocultas bajo pisos o detrás de paredes. Reparamos la pérdida y reponemos albañilería y cerámicas.",
    urgente: true
  },
  {
    title: "Instalación y Recambio de Calefones",
    desc: "Instalación certificada de termotanques de todas las marcas (James, Enxuta, Ariston, etc.), cambio de colillas metálicas, válvulas de seguridad y termostatos.",
    urgente: true
  },
  {
    title: "Termofusión y Cañerías Nuevas",
    desc: "Sustitución de cañerías antiguas de plomo o hierro galvanizado por polipropileno termofusionado de máxima durabilidad y libre de sarro.",
    urgente: false
  },
  {
    title: "Griferías, Cisternas e Inodoros",
    desc: "Reparación o recambio de monocomandos de cocina y baño, mochilas de inodoros, válvulas de descarga, fuelles y sifones.",
    urgente: false
  },
  {
    title: "Bombas Presurizadoras y Tanques",
    desc: "Instalación y mantenimiento de bombas de presión de agua para duchas y grifos, tanques de reserva y sistemas automáticos.",
    urgente: false
  }
];

const galleryItems = [
  {
    title: "Instalación de cañerías por termofusión en Montevideo",
    description: "Renovación integral de distribución de agua fría y caliente en termofusión de 20mm y 25mm con prueba hidráulica certificada a 10 bar.",
    location: "Pocitos, Montevideo",
    image: "/images/servicios/sanitaria.svg",
    alt: "Instalación de cañerías por termofusión en Montevideo",
    tag: "Termofusión"
  },
  {
    title: "Destape mecánico de graseras y ramales de desagüe",
    description: "Limpieza profunda con desobstructora rotativa electromecánica en cocina comercial para restaurante en zona céntrica.",
    location: "Cordón / Centro, Montevideo",
    image: "/images/servicios/sanitaria.svg",
    alt: "Destape mecánico de graseras en Cordón Montevideo",
    tag: "Destape Rotativo"
  },
  {
    title: "Recambio de calefón de 80L y presurización de línea",
    description: "Montaje sobre pared de mampostería, colillas de acero inoxidable mallado, válvula de alivio y bomba automática de bajo consumo.",
    location: "Carrasco, Montevideo",
    image: "/images/servicios/sanitaria.svg",
    alt: "Instalación de calefón y válvulas en Carrasco Montevideo",
    tag: "Instalación Termotanque"
  }
];
---

<Layout
  title="Sanitaria de Urgencia 24/7 en Montevideo y Canelones | Sinai Mantenimiento"
  description="Servicio de sanitaria profesional y de urgencias en Montevideo y Canelones. Destapes con máquina, pérdidas de agua, cambio de calefones y cañerías. Factura con RUT. Atención 365 días por Andrés y Verónica."
>
  <Header />

  <!-- Emergency Hero for Sanitaria -->
  <section class="bg-gradient-to-b from-slate-950 via-slate-900 to-blue-950 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/90 text-white text-xs font-bold uppercase tracking-wider mb-6 animate-pulse">
          <span class="w-2 h-2 rounded-full bg-white"></span>
          <span>Guardia de Urgencia Sanitaria 365 Días</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
          Sanitaria Profesional y Destapes en Montevideo y Canelones
        </h1>

        <p class="mt-6 text-base sm:text-xl text-slate-300 leading-relaxed">
          ¿Caño roto, desborde de grasera o calefón perdiendo agua? Llegamos rápido con herramientas de última tecnología. <strong class="text-white">Factura oficial con RUT</strong> para empresas, consorcios y particulares.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
          <a
            href="https://wa.me/59896219719?text=URGENCIA%20SANITARIA:%20Hola%20Andr%C3%A9s%20y%20Ver%C3%B3nica,%20necesito%20asistencia%20sanitaria%20inmediata"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-red-600 hover:bg-red-500 text-white font-extrabold px-7 py-4 rounded-2xl shadow-xl shadow-red-600/30 text-base transition-all"
          >
            <span>Pedir Sanitario de Urgencia (WhatsApp)</span>
          </a>

          <a
            href="tel:+59896219719"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-bold px-7 py-4 rounded-2xl border border-slate-700 text-base transition-all"
          >
            <span>Llamar: 096 219 719</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sanitary Services Details -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Especialistas en Sanitarias Residenciales y Comerciales
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Solucionamos roturas imprevistas y realizamos instalaciones nuevas completas con materiales normados en Uruguay.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sanitaryServices.map((srv) => (
          <div class="bg-white rounded-3xl p-7 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                  </svg>
                </span>
                {srv.urgente && (
                  <span class="text-xs font-bold text-red-600 bg-red-50 border border-red-200 px-2.5 py-0.5 rounded-full">
                    Atención Urgente
                  </span>
                )}
              </div>

              <h3 class="text-xl font-black text-slate-900 mb-2">{srv.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{srv.desc}</p>
            </div>

            <div class="mt-6 pt-5 border-t border-slate-100">
              <a
                href={`https://wa.me/59896219719?text=${encodeURIComponent(`Hola Andrés y Verónica, consulto por el servicio de ${srv.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-blue-600 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition-colors"
              >
                Cotizar este trabajo por WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Work Gallery -->
  <WorkGallery
    title="Galería de Obras Sanitarias y Reparaciones Técnicas"
    subtitle="Intervenciones reales ejecutadas por nuestro equipo en Montevideo y Canelones con materiales de primera línea."
    serviceCategory="Sanitaria Integral"
    items={galleryItems}
  />

  <!-- Form integration -->
  <ContactForm />

  <Footer />
  <WhatsAppButton />
</Layout>
