---
---

<section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Subtle background glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -left-40 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Pill badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-300 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
          <span>SINAI MANTENIMIENTO INTEGRAL • URUGUAY</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight sm:leading-none">
          Mantenimiento Técnico y <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-300 to-teal-300">Sanitaria Profesional</span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Atendemos hogares, empresas, comercios y administraciones de consorcios en todo Montevideo y Canelones. <strong class="text-white font-bold">Atención los 365 días del año</strong> con <strong class="text-white font-bold">facturación oficial con RUT</strong> y la seriedad directa de <span class="text-blue-300 font-semibold">Andrés y Verónica</span>.
        </p>

        <!-- Differential badges grid -->
        <div class="grid grid-cols-2 sm:grid-cols-2 gap-3 pt-2 max-w-xl mx-auto lg:mx-0 text-left">
          <div class="flex items-center gap-2.5 bg-slate-800/80 border border-slate-700/80 p-2.5 rounded-xl backdrop-blur-sm">
            <div class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white">365 Días al Año</div>
              <div class="text-[11px] text-slate-400">Guardias de urgencia</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 bg-slate-800/80 border border-slate-700/80 p-2.5 rounded-xl backdrop-blur-sm">
            <div class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white">Factura con RUT</div>
              <div class="text-[11px] text-slate-400">Empresas y consorcios</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 bg-slate-800/80 border border-slate-700/80 p-2.5 rounded-xl backdrop-blur-sm">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/20 text-indigo-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white">7 Rubros de Obra</div>
              <div class="text-[11px] text-slate-400">Todo en una sola empresa</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 bg-slate-800/80 border border-slate-700/80 p-2.5 rounded-xl backdrop-blur-sm">
            <div class="w-8 h-8 rounded-lg bg-amber-600/20 text-amber-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white">Andrés y Verónica</div>
              <div class="text-[11px] text-slate-400">Trato directo y cercano</div>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="https://wa.me/59896219719?text=Hola%20Andr%C3%A9s%20y%20Ver%C3%B3nica,%20quisiera%20solicitar%20un%20presupuesto%20inmediato"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white text-base font-extrabold px-7 py-4 rounded-2xl shadow-xl shadow-emerald-600/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Cotizar por WhatsApp</span>
          </a>

          <a
            href="#contacto"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white text-base font-bold px-7 py-4 rounded-2xl border border-slate-600 hover:border-blue-500 transition-all duration-200"
          >
            <span>Formulario con RUT</span>
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <p class="text-xs text-slate-400 flex items-center justify-center lg:justify-start gap-2">
          <svg class="w-4 h-4 text-emerald-400 inline shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Respondemos en menos de 15 minutos en horario comercial y guardia activa.</span>
        </p>
      </div>

      <!-- Right Column: Interactive Highlights Card -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-slate-800 to-slate-900 border border-slate-700 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-6 border-b border-slate-700">
            <div>
              <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">Cobertura Multirubro</span>
              <h3 class="text-xl font-extrabold text-white mt-0.5">Soluciones de Punta a Punta</h3>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-blue-600/20 text-blue-300 text-xs font-semibold border border-blue-500/30">
              Uruguay
            </span>
          </div>

          <!-- Quick Service List -->
          <div class="py-6 space-y-3">
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-sm font-bold">1</span>
                <div>
                  <h4 class="text-sm font-bold text-white">Sanitaria y Destapes</h4>
                  <p class="text-xs text-slate-400">Caños, fugas, calefones y bombas</p>
                </div>
              </div>
              <span class="text-[11px] text-red-400 font-bold bg-red-950/40 px-2 py-0.5 rounded border border-red-800/40">24/7 Urgencias</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-sm font-bold">2</span>
                <div>
                  <h4 class="text-sm font-bold text-white">Herrería de Obra</h4>
                  <p class="text-xs text-slate-400">Rejas, portones, pérgolas y soldadura</p>
                </div>
              </div>
              <span class="text-[11px] text-slate-400 font-medium">A Medida</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-sm font-bold">3</span>
                <div>
                  <h4 class="text-sm font-bold text-white">Albañilería y Reformas</h4>
                  <p class="text-xs text-slate-400">Baños, cocinas, pisos y contrapisos</p>
                </div>
              </div>
              <span class="text-[11px] text-slate-400 font-medium">Llave en mano</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-sm font-bold">4</span>
                <div>
                  <h4 class="text-sm font-bold text-white">Impermeabilizaciones</h4>
                  <p class="text-xs text-slate-400">Azoteas, membranas y filtraciones</p>
                </div>
              </div>
              <span class="text-[11px] text-emerald-400 font-medium bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-800/40">Garantía</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-sm font-bold">5</span>
                <div>
                  <h4 class="text-sm font-bold text-white">Yeso, Pintura y Limpieza</h4>
                  <p class="text-xs text-slate-400">Drywall, terminaciones finas y predios</p>
                </div>
              </div>
              <span class="text-[11px] text-blue-400 font-medium">Integral</span>
            </div>
          </div>

          <!-- Bottom card note -->
          <div class="pt-4 border-t border-slate-700 flex items-center justify-between text-xs text-slate-400">
            <span>Andrés y Verónica coordinan tu obra</span>
            <a href="#servicios" class="text-blue-400 hover:text-blue-300 font-semibold flex items-center gap-1">
              Ver los 7 rubros →
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
