---
export interface GalleryItem {
  title: string;
  description: string;
  location: string;
  image: string;
  alt: string;
  tag: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  serviceCategory?: string;
  items: GalleryItem[];
}

const {
  title = "Galería de Trabajos Realizados",
  subtitle = "Obras y proyectos ejecutados con respaldo técnico y garantía en Montevideo y Canelones.",
  serviceCategory = "Mantenimiento",
  items = []
} = Astro.props;
---

<section class="py-20 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-4">
        Respaldo Visual • {serviceCategory}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map((item, idx) => (
        <article class="group bg-slate-50 border border-slate-200 rounded-3xl overflow-hidden hover:shadow-xl hover:border-blue-400 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Image Wrapper with Lazy Loading -->
            <div class="relative overflow-hidden bg-slate-900 aspect-[16/10]">
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                width="800"
                height="500"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
              
              <!-- Location badge overlay -->
              <div class="absolute top-3.5 left-3.5 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-white text-[11px] font-semibold border border-white/20 shadow-sm">
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{item.location}</span>
              </div>

              <!-- Tag badge overlay -->
              <div class="absolute bottom-3.5 right-3.5 px-2.5 py-0.5 rounded-full bg-blue-600 text-white text-[11px] font-extrabold uppercase tracking-wider shadow">
                {item.tag}
              </div>
            </div>

            <!-- Content Card -->
            <div class="p-6">
              <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors leading-tight mb-2">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>

          <!-- Card Footer CTA -->
          <div class="px-6 pb-6 pt-2">
            <a
              href={`https://wa.me/59896219719?text=${encodeURIComponent(`Hola Andrés y Verónica, quisiera consultar por un trabajo similar a: ${item.title} (${item.location})`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white hover:bg-emerald-600 text-slate-800 hover:text-white font-bold text-xs border border-slate-200 hover:border-transparent transition-all shadow-sm group-hover:shadow"
            >
              <svg class="w-3.5 h-3.5 text-emerald-600 group-hover:text-white fill-current transition-colors" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Consultar Trabajo Similar</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
