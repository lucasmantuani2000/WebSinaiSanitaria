---

<section id="servicios" class="py-20 lg:py-28 bg-slate-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase tracking-wider mb-4">
        Servicios Multirubro Especializados
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Todo el Mantenimiento de tu Propiedad en Manos Expertas
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Olvídate de coordinar múltiples contratistas que no se entienden entre sí. En <strong>Sinai Mantenimiento</strong> centralizamos los 7 rubros clave con garantía, factura con RUT y supervisión de Andrés y Verónica.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div 
          class={`relative rounded-3xl p-7 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 ${
            service.highlight
              ? "bg-white border-2 border-red-500 shadow-xl shadow-red-500/10 lg:col-span-1 md:col-span-2 lg:col-span-1"
              : "bg-white border border-slate-200 hover:border-blue-400 hover:shadow-xl shadow-sm"
          }`}
        >
          {service.highlight && (
            <div class="absolute -top-3.5 right-6 bg-red-600 text-white text-[11px] font-black uppercase tracking-wider px-3 py-0.5 rounded-full shadow-md animate-pulse">
              Servicio Más Solicitado
            </div>
          )}

          <div>
            <!-- Header of card -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`inline-block text-xs font-extrabold px-3 py-1 rounded-full border ${service.badgeColor}`}>
                {service.badge}
              </span>
              <span class="text-xs font-bold text-slate-400">
                0{index + 1}
              </span>
            </div>

            <!-- Technical Image with Lazy Loading -->
            <a href={service.href} class="block mb-5 overflow-hidden rounded-2xl bg-slate-900 aspect-[16/9] border border-slate-200/60 group/img">
              <img
                src={service.image}
                alt={service.alt}
                loading="lazy"
                decoding="async"
                width="800"
                height="500"
                class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
              />
            </a>

            <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-3 tracking-tight">
              <a href={service.href} class="hover:text-blue-600 transition-colors">
                {service.name}
              </a>
            </h3>

            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- Checklist -->
            <div class="border-t border-slate-100 pt-5 mb-8">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Trabajos frecuentes:</h4>
              <ul class="space-y-2.5">
                {service.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
                    <svg class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-4 border-t border-slate-100 flex flex-col gap-2.5">
            <a
              href={`https://wa.me/59896219719?text=${encodeURIComponent(service.whatsappText)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 ${
                service.highlight
                  ? "bg-red-600 hover:bg-red-700 text-white shadow-md shadow-red-600/20"
                  : "bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/20"
              }`}
