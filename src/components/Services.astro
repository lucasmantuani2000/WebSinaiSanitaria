    <!-- Banner below services -->
    <div class="mt-14 bg-gradient-to-r from-blue-700 via-blue-600 to-blue-800 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
