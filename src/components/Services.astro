              class="text-center text-xs font-bold text-blue-600 hover:text-blue-800 transition-colors py-1 flex items-center justify-center gap-1"
            >
              <span>Ver página completa de {service.name.split(' ')[0]}</span>
              <span>→</span>
            </a>
          </div>
        </div>
