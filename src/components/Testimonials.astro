---
const testimonials = [
  {
    author: "Ing. Gonzalo M.",
    role: "Administrador de Copropiedad • Edificio en Pocitos",
    text: "Un domingo a la tarde tuvimos una rotura en el montante sanitario que afectaba a dos pisos. Andrés y el equipo llegaron rapidísimo, contuvieron la pérdida y al día siguiente dejaron todo reparado con prueba hidráulica. La factura oficial con RUT nos permitió liquidar el gasto sin ningún reparo de los copropietarios.",
    stars: 5,
    tag: "Sanitaria de Urgencia"
  },
  {
    author: "Mariana R.",
    role: "Propietaria • El Pinar, Canelones",
    text: "Contacté a Verónica por WhatsApp porque las lluvias nos filtraban por el techo de la casa. Hicieron la impermeabilización completa con membrana de 4mm y además nos pintaron el cielorraso de yeso que se había manchado. El trato humano y la prolijidad de Sinai es difícil de encontrar hoy en día.",
    stars: 5,
    tag: "Impermeabilización y Yeso"
  },
  {
    author: "Sebastián D.",
    role: "Gerente Gastronómico • Cordón / Centro",
    text: "En un restaurante un atasco en la grasera te para la cocina. Llamamos a Sinai y en menos de una hora estaban acá con la máquina rotativa. Destaparon y limpiaron todo con máxima discreción y rapidez. Son nuestros sanitarios de cabecera.",
    stars: 5,
    tag: "Destapes Comerciales"
  },
  {
    author: "Arq. Valentina F.",
    role: "Estudio de Arquitectura • Reformas en Montevideo",
    text: "Como profesional valoro mucho que cumplan con los tiempos estipulados y que los detalles de terminación en herrería y pintura sean impecables. Andrés y Verónica supervisan de cerca a su gente y eso marca una diferencia enorme en obra.",
    stars: 5,
    tag: "Reformas y Terminaciones"
  }
];
---

<section class="py-20 lg:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-4">
        Opiniones Reales
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Clientes que Confían en Sinai Mantenimiento
      </h2>
      <p class="mt-3 text-base text-slate-600">
        Empresas, administraciones de consorcios y familias de Montevideo y Canelones respaldan nuestra trayectoria.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white rounded-3xl p-7 sm:p-8 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <!-- Stars & Tag -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex items-center text-amber-400">
                {Array.from({ length: t.stars }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="text-xs font-semibold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-100">
                {t.tag}
              </span>
            </div>

            <!-- Quote -->
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed italic mb-6">
              "{t.text}"
            </p>
          </div>

          <!-- Author info -->
          <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-900 text-white font-black text-sm flex items-center justify-center">
              {t.author.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-bold text-slate-900">{t.author}</div>
              <div class="text-xs text-slate-500">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
