---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Column 1: Brand & Details -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 to-blue-500 flex items-center justify-center text-white font-black text-lg">
            S
          </div>
          <div>
            <span class="text-xl font-black text-white tracking-tight">SINAI</span>
            <span class="block text-xs font-semibold text-blue-400 uppercase tracking-wider">Mantenimiento Integral</span>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Empresa uruguaya de mantenimiento integral y sanitaria. Soluciones técnicas para hogares, comercios, consorcios y edificios con <strong>facturación oficial con RUT</strong> y atención los <strong>365 días del año</strong>.
        </p>

        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Atendido personalmente por <strong>Andrés y Verónica</strong></span>
          </p>
          <p class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>RUT Oficial para Empresas y Edificios</span>
          </p>
        </div>
      </div>

      <!-- Column 2: Servicios -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Rubros</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/#servicios" class="hover:text-white transition-colors">Sanitaria y Destapes</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Herrería de Obra</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Albañilería y Reformas</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Impermeabilizaciones</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Drywall y Yeso</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Pintura Profesional</a></li>
          <li><a href="/#servicios" class="hover:text-white transition-colors">Limpieza y Jardinería</a></li>
        </ul>
      </div>

      <!-- Column 3: Zonas -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Zonas de Cobertura</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/#zonas" class="hover:text-white transition-colors">Montevideo (Todos los barrios)</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">Pocitos, Punta Carretas, Centro</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">Carrasco, Malvín, Buceo</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">Ciudad de la Costa (Canelones)</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">El Pinar, Solymar, Lagomar</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">Las Piedras y Pando</a></li>
          <li><a href="/#zonas" class="hover:text-white transition-colors">Interior del País (Obras)</a></li>
        </ul>
      </div>

      <!-- Column 4: Contacto Directo -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Contacto Directo</h4>
        <div class="space-y-3 text-xs sm:text-sm">
          <div>
            <div class="text-slate-400 text-xs">WhatsApp / Móvil:</div>
            <a href="tel:+59896219719" class="font-bold text-white hover:text-blue-400 transition-colors">
              +598 96 219 719
            </a>
            <div class="text-[11px] text-slate-500">096 219 719 (Uruguay)</div>
          </div>

          <div>
            <div class="text-slate-400 text-xs">Correo Electrónico:</div>
            <a href="mailto:vegaandres7321@gmail.com" class="font-medium text-slate-300 hover:text-white transition-colors break-all">
              vegaandres7321@gmail.com
            </a>
          </div>

          <div>
            <div class="text-slate-400 text-xs">Guardia de Urgencias:</div>
            <span class="text-red-400 font-bold">Activa los 365 días</span>
          </div>

          <div class="pt-2">
            <a
              href="https://wa.me/59896219719?text=Hola%20Andr%C3%A9s%20y%20Ver%C3%B3nica,%20me%20comunico%20desde%20el%20sitio%20web"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-lg text-xs font-bold transition-colors"
            >
              <span>Chatear por WhatsApp</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} Sinai Mantenimiento Integral. Todos los derechos reservados. Uruguay.
      </p>
      <div class="flex items-center gap-4">
        <span>Facturación con RUT oficial</span>
        <span>•</span>
        <a href="#urgencias" class="text-red-400 hover:text-red-300 font-bold">Urgencias Sanitarias</a>
      </div>
    </div>
  </div>
</footer>
