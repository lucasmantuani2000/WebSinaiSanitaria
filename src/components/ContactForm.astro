---

<section id="contacto" class="py-20 lg:py-28 bg-slate-100 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Contact Details & Personal intro -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase tracking-wider mb-4">
            Atención Inmediata
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            Coordinemos tu Presupuesto Hoy Mismo
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed">
            Puedes completar el formulario formal con datos de facturación con RUT o escribirnos directamente a nuestro WhatsApp personal para una respuesta instantánea.
          </p>
        </div>

        <!-- Direct Contact Cards -->
        <div class="space-y-4">
          <!-- WhatsApp / Tel -->
          <a
            href="https://wa.me/59896219719?text=Hola%20Andr%C3%A9s%20y%20Ver%C3%B3nica,%20quisiera%20solicitar%20un%20presupuesto"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 flex items-center gap-4 transition-all shadow-sm hover:shadow-md group"
          >
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">WhatsApp & Guardia</div>
              <div class="text-lg font-extrabold text-slate-900">+598 96 219 719</div>
              <div class="text-xs text-emerald-600 font-medium">Disponible ahora • Respuesta rápida</div>
            </div>
          </a>

          <!-- Direct Phone -->
          <a
            href="tel:+59896219719"
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-blue-500 flex items-center gap-4 transition-all shadow-sm hover:shadow-md group"
          >
            <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Llamada Telefónica</div>
              <div class="text-lg font-extrabold text-slate-900">096 219 719</div>
              <div class="text-xs text-slate-500">Línea móvil directa Uruguay</div>
            </div>
          </a>

          <!-- Email -->
          <a
            href="mailto:vegaandres7321@gmail.com"
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-blue-500 flex items-center gap-4 transition-all shadow-sm hover:shadow-md group"
          >
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Correo Electrónico</div>
              <div class="text-base font-extrabold text-slate-900 break-all">vegaandres7321@gmail.com</div>
              <div class="text-xs text-slate-500">Para pliegos, planos y licitaciones</div>
            </div>
          </a>
        </div>

        <!-- Personal note from Andrés and Verónica -->
        <div class="p-5 rounded-2xl bg-blue-50/80 border border-blue-200 text-sm text-blue-900">
          <div class="font-bold flex items-center gap-2 mb-1">
            <span>Atendido personalmente por sus titulares</span>
          </div>
          <p class="text-xs text-blue-800 leading-relaxed">
            "En Sinai Mantenimiento, nosotros mismos supervisamos la calidad de cada obra y aseguramos que la factura con RUT llegue en tiempo y forma. Gracias por confiar en nosotros." — Andrés y Verónica.
          </p>
        </div>
      </div>

      <!-- Netlify Contact Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200">
          <div class="mb-6">
            <h3 class="text-2xl font-black text-slate-900">Solicitar Presupuesto Formal</h3>
            <p class="text-sm text-slate-500 mt-1">Completa los datos y te enviaremos una estimación detallada.</p>
          </div>

          <!-- The Netlify Form -->
          <form
            name="contacto"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/gracias"
            class="space-y-5"
          >
            <!-- Hidden Netlify form identifier -->
            <input type="hidden" name="form-name" value="contacto" />

            <!-- Honeypot for spam bots -->
            <p class="hidden">
              <label>No completar este campo: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Name -->
              <div>
                <label for="nombre" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Nombre Completo *
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Ej: Laura Rodríguez / Arq. Martínez"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all placeholder:text-slate-400"
                />
              </div>

              <!-- Phone / WhatsApp -->
              <div>
                <label for="telefono" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Teléfono / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  required
                  placeholder="Ej: 099 123 456"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all placeholder:text-slate-400"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Email -->
              <div>
                <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Email de Contacto *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="tuemail@ejemplo.com"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all placeholder:text-slate-400"
                />
              </div>

              <!-- Facturación / RUT -->
              <div>
                <label for="facturacion" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Facturación Oficial
                </label>
                <select
                  id="facturacion"
                  name="facturacion"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all bg-white"
                >
                  <option value="con-rut">Deseo Factura Oficial con RUT</option>
                  <option value="consumidor-final">Consumidor Final (Particular)</option>
                  <option value="edificio-consorcio">Consorcio / Edificio de Copropiedad</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Service Selection -->
              <div>
                <label for="rubro" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Rubro Principal *
                </label>
                <select
                  id="rubro"
                  name="rubro"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all bg-white"
                >
                  <option value="">Selecciona un rubro...</option>
                  <option value="sanitaria">Sanitaria y Destapes de Urgencia</option>
                  <option value="herreria">Herrería (Rejas, Portones, Estructuras)</option>
                  <option value="albanileria">Albañilería y Reformas</option>
                  <option value="impermeabilizaciones">Impermeabilización de Azoteas / Techos</option>
                  <option value="drywall">Drywall / Yeso y Cielorrasos</option>
                  <option value="pintura">Pintura Interior / Exterior</option>
                  <option value="limpieza-jardineria">Limpieza de Obra o Jardinería</option>
                  <option value="proyecto-integral">Proyecto Combinado / Integral</option>
                </select>
              </div>

              <!-- Urgency Level -->
              <div>
                <label for="urgencia" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Nivel de Urgencia *
                </label>
                <select
                  id="urgencia"
                  name="urgencia"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all bg-white"
                >
                  <option value="inmediata">🚨 Urgencia Hoy Mismo / Lo antes posible</option>
                  <option value="semana">En el correr de la semana</option>
                  <option value="planificado">Planificación a mediano plazo / Cotización de obra</option>
                </select>
              </div>
            </div>

            <!-- Location / Zone -->
            <div>
              <label for="ubicacion" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Barrio o Localidad (Montevideo / Canelones / Interior) *
              </label>
              <input
                type="text"
                id="ubicacion"
                name="ubicacion"
                required
                placeholder="Ej: Pocitos, Ciudad de la Costa, Carrasco, Cordón..."
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all placeholder:text-slate-400"
              />
            </div>

            <!-- Message / Scope -->
            <div>
              <label for="mensaje" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Detalle del Trabajo o Proyecto *
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                required
                placeholder="Describe brevemente qué necesitas resolver (tipo de pérdida, medidas aproximadas, reforma de qué ambiente, etc.)."
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all placeholder:text-slate-400"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-base py-4 rounded-xl shadow-lg shadow-blue-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
            >
              <span>Enviar Solicitud de Presupuesto</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <p class="text-[11px] text-center text-slate-500">
              Tus datos son confidenciales y solo se utilizarán para la confección del presupuesto solicitado.
            </p>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>
